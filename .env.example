# Copy to .env for local development. Dev defaults only; never put real secrets here.
CIP_ENV=dev
CIP_DB_NAME=cip
CIP_DB_OWNER=cip_owner
CIP_DB_OWNER_PASSWORD=cip_owner_dev
CIP_DB_APP_USER=cip_app
CIP_DB_APP_PASSWORD=cip_app_dev
CIP_DB_PORT=55432
CIP_REDIS_PORT=56379
CIP_API_PORT=58000
# Sign-in (docs/auth.md). dev = dev login for pilots; oidc = company identity provider.
CIP_AUTH_PROVIDER=dev
CIP_SESSION_HOURS=12
CIP_PIN_MAX_ATTEMPTS=5
# CIP_OIDC_ISSUER=https://login.microsoftonline.com/<directory-id>/v2.0
# CIP_OIDC_AUDIENCE=<application-client-id>
# CIP_OIDC_JWKS_URL=https://login.microsoftonline.com/<directory-id>/discovery/v2.0/keys
