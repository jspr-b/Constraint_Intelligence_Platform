{
  "name": "constraint-intelligence-platform",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "onboarding:pdf": "uv run python scripts/gen_onboarding.py && pnpm --filter web exec node scripts/onboarding-pdf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
