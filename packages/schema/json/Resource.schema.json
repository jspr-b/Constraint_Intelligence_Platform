{
  "$defs": {
    "ResourceKind": {
      "enum": [
        "machine",
        "manual",
        "station",
        "work_centre"
      ],
      "title": "ResourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A step: a machine, a handmade bench, a check. Belongs to exactly one station.\n\n``parallel_units`` is how many jobs it can work on at once (machines side by side, or\nbenches); shifts may set fewer or more staffed positions (``CalendarWindow.positions``).",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ResourceKind",
      "default": "machine"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "parallel_units": {
      "default": 1,
      "minimum": 1,
      "title": "Parallel Units",
      "type": "integer"
    },
    "resource_code": {
      "pattern": "^[A-Z][A-Z0-9-]{1,31}$",
      "title": "Resource Code",
      "type": "string"
    },
    "station_code": {
      "pattern": "^[A-Z][A-Z0-9-]{1,31}$",
      "title": "Station Code",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "resource_code",
    "name",
    "station_code"
  ],
  "title": "Resource",
  "type": "object"
}
